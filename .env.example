# Copilot SDK（必填：具有 GitHub Copilot 访问权限的 token）
COPILOT_GITHUB_TOKEN=

# 应用访问控制（生产环境建议开启）
CCA_SECURITY_ENABLED=false
CCA_API_KEY=

# Copilot
CCA_COPILOT_ENABLED=true
CCA_COPILOT_MODEL=gpt-5

# 应用端口（宿主机端口；容器内固定 8787）
APP_PORT=8787

# MySQL（外部实例 192.168.100.231，库/用户均为 cgnew）
SPRING_DATASOURCE_URL=jdbc:mysql://192.168.100.231:3306/cgnew?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=cgnew
SPRING_DATASOURCE_PASSWORD=123456
